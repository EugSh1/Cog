{
    "name": "cog-http",
    "version": "2.0.1",
    "description": "Tiny HTTP framework built on node:http",
    "license": "MIT",
    "author": "EugSh1",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/EugSh1/cog-http.git"
    },
    "homepage": "https://eugsh1.github.io/cog-http",
    "keywords": [
        "cog",
        "cog-http",
        "http-server",
        "server",
        "backend",
        "web",
        "http",
        "framework",
        "router",
        "node",
        "nodejs",
        "api",
        "lightweight"
    ],
    "scripts": {
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "lint": "eslint src",
        "build": "tsc -p tsconfig.build.json",
        "docs:dev": "cd docs && npm run start",
        "docs:build": "cd docs && npm run build",
        "docs:deploy": "cd docs && npm run deploy"
    },
    "peerDependencies": {
        "@types/node": ">=18"
    },
    "devDependencies": {
        "@eslint/js": "^9.27.0",
        "@types/node": "^22.15.18",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.27.0",
        "eslint-plugin-import": "^2.31.0",
        "globals": "^16.1.0",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.1",
        "vitest": "^3.2.4"
    }
}
